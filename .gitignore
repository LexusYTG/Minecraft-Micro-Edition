# Directorios de compilación completos
build/
MMEfinal/
# Archivos objeto y dependencias (C/C++)
*.o
*.d
*.map
*.elf
*.elf.stripped
*.elf.sym

# Binarios finales y ROMs
*.z64
*.PBP
PARAM.SFO

# Compilados de Java / J2ME
*.class
